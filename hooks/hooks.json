{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^mcp__(plugin_leadmagic_)?leadmagic__[a-z0-9_]+$",
				"hooks": [
					{
						"type": "command",
						"command": "/usr/bin/python3",
						"args": ["-I", "-S", "${CLAUDE_PLUGIN_ROOT}/scripts/approval-policy.py", "${user_config.ask_all}"],
						"timeout": 5
					}
				]
			}
		]
	}
}
